#!/sbin/openrc-run
# shellcheck disable=SC2034
# bluetooth: unified Bluetooth stack (bluetoothd + bluealsa).
# Only started when the user has enabled Bluetooth under
# /mnt/sdcard/.minime/config/bluetooth/enabled.

description="Bluetooth stack (bluetoothd + bluealsa)"

depend() {
	need dbus modules
	before ui
	after fb-unblank
}

start() {
	# Enable on first boot if no config directory exists yet
	if [ ! -f /mnt/sdcard/.minime/config/bluetooth/enabled ] && [ ! -d /mnt/sdcard/.minime/config/bluetooth ]; then
		mkdir -p /mnt/sdcard/.minime/config/bluetooth
		echo 1 >/mnt/sdcard/.minime/config/bluetooth/enabled
	fi

	if [ ! -f /mnt/sdcard/.minime/config/bluetooth/enabled ]; then
		einfo "Bluetooth disabled by user"
		return 0
	fi
	ebegin "Starting Bluetooth stack"

	# 1. bluetoothd
	bluetoothd_bin="$(command -v bluetoothd 2>/dev/null || true)"
	if [ -z "${bluetoothd_bin}" ]; then
		for path in /usr/libexec/bluetooth/bluetoothd /usr/lib/bluetooth/bluetoothd; do
			if [ -x "${path}" ]; then
				bluetoothd_bin="${path}"
				break
			fi
		done
	fi
	if [ -z "${bluetoothd_bin}" ]; then
		eend 1 "bluetoothd binary not found"
		return 1
	fi

	mkdir -p /var/lib/bluetooth
	chmod 700 /var/lib/bluetooth 2>/dev/null || true
	start-stop-daemon -S -q -b -m \
		-p /run/bluetoothd.pid \
		-x "${bluetoothd_bin}" -- -n
	if [ $? -ne 0 ]; then
		eend 1 "bluetoothd failed to start"
		return 1
	fi

	# 2. BlueALSA
	bluealsa_bin="$(command -v bluealsa 2>/dev/null || echo /usr/bin/bluealsa)"
	start-stop-daemon -S -q -b -m \
		-p /run/bluealsa.pid \
		-x "${bluealsa_bin}" -- -p a2dp-sink -p a2dp-source
	# BlueALSA failure is non-fatal (audio routing only)
	eend 0
}

stop() {
	ebegin "Stopping Bluetooth stack"

	start-stop-daemon -K -q -p /run/bluealsa.pid 2>/dev/null || true
	rm -f /run/bluealsa.pid

	start-stop-daemon -K -q -p /run/bluetoothd.pid 2>/dev/null || true
	rm -f /run/bluetoothd.pid

	eend 0
}
