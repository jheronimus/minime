#!/sbin/openrc-run
# shellcheck disable=SC2034
# bluetooth: unified Bluetooth stack (dbus + bluetoothd + bluealsa).
# Only started when the user has enabled Bluetooth under
# /mnt/sdcard/.minime/config/bluetooth/enabled.

description="Bluetooth stack (dbus + bluetoothd + bluealsa)"

depend() {
	need modules
	before ui
	after fb-unblank
}

start() {
	if [ ! -f /mnt/sdcard/.minime/config/bluetooth/enabled ]; then
		einfo "Bluetooth disabled by user"
		return 0
	fi
	ebegin "Starting Bluetooth stack"

	# 1. D-Bus — clean up any stale pidfile/socket left by a previous
	#    partial stop so dbus-daemon can always start.
	mkdir -p /run/dbus
	if [ -f /run/dbus/dbus.pid ] && ! kill -0 "$(cat /run/dbus/dbus.pid 2>/dev/null)" 2>/dev/null; then
		rm -f /run/dbus/dbus.pid
	fi
	rm -f /run/dbus/system_bus_socket
	dbus-uuidgen --ensure
	dbus-daemon --system --fork
	if [ $? -ne 0 ]; then
		eend 1 "dbus-daemon failed to start"
		return 1
	fi

	# 2. bluetoothd
	mkdir -p /var/lib/bluetooth
	chmod 700 /var/lib/bluetooth 2>/dev/null || true
	start-stop-daemon -S -q -b -m \
		-p /run/bluetoothd.pid \
		-x /usr/lib/bluetooth/bluetoothd -- -n
	if [ $? -ne 0 ]; then
		eend 1 "bluetoothd failed to start"
		return 1
	fi

	# 3. BlueALSA
	start-stop-daemon -S -q -b -m \
		-p /run/bluealsa.pid \
		-x /usr/bin/bluealsa -- -p a2dp-sink -p a2dp-source
	# BlueALSA failure is non-fatal (audio routing only)
	eend 0
}

stop() {
	ebegin "Stopping Bluetooth stack"

	start-stop-daemon -k -q -p /run/bluealsa.pid 2>/dev/null || true
	rm -f /run/bluealsa.pid

	start-stop-daemon -k -q -p /run/bluetoothd.pid 2>/dev/null || true
	rm -f /run/bluetoothd.pid

	# dbus-daemon --fork writes /run/dbus/dbus.pid (not /run/dbus/pid).
	# Kill by the correct pidfile and clear stale state for a clean start.
	start-stop-daemon -k -q -p /run/dbus/dbus.pid 2>/dev/null || true
	rm -f /run/dbus/dbus.pid /run/dbus/system_bus_socket

	eend 0
}
