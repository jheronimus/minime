#!/sbin/openrc-run
# shellcheck disable=SC2034
# ui: launch the UI binary (MinUI/Allium) and the headphone-jack watcher.
# UI-agnostic — no IPC conventions, no relaunch loops.
# UI-specific behavior (relaunch, /tmp/next, /tmp/poweroff) belongs in
# the UI's own launch.sh, not here.

description="Minime UI (MinUI/Allium)"

# --- Configuration ---
TRAITS_FILE="/mnt/sdcard/.minime/traits"
ASOUNDRC_FILE="/mnt/sdcard/.asoundrc"
UI_ENV_FILE="/mnt/sdcard/.minime/ui.env"

# --- Helper functions ---

get_trait() {
	key="$1"
	[ -f "$TRAITS_FILE" ] || return 0
	grep "^${key}=" "$TRAITS_FILE" | cut -d= -f2 | tr -d '\r' || true
}

log_boot() {
	/usr/share/minime/scripts/log-boot.sh UI "$@" 2>/dev/null || true
}

read_ui_env() {
	key="$1"
	[ -f "$UI_ENV_FILE" ] || return 0
	grep "^${key}=" "$UI_ENV_FILE" | cut -d= -f2 | tr -d '\r"' || true
}

# --- OpenRC service ---

depend() {
	after modules fb-unblank traits gpudriver localmount
}

start() {
	ebegin "Starting UI"

	dmesg -n 1 2>/dev/null || true

	UI_NAME=$(read_ui_env UI_NAME)
	UI_BIN=$(read_ui_env UI_BIN)
	UI_PROCESSES=$(read_ui_env UI_PROCESSES)

	audio_card=$(get_trait audio_card)
	audio_mixer=$(get_trait audio_mixer)
	if [ -n "$audio_card" ] && [ "$audio_card" != "default" ]; then
		printf 'pcm.!default {\n    type hw\n    card %s\n}\nctl.!default {\n    type hw\n    card %s\n}\n' \
			"$audio_card" "$audio_card" >"$ASOUNDRC_FILE"
	else
		rm -f "$ASOUNDRC_FILE"
	fi

	if [ -n "$audio_mixer" ]; then
		amixer sset "$audio_mixer" 100% unmute >/dev/null 2>&1 || true
	fi

	if [ -n "$audio_card" ] && [ "$audio_card" != "default" ] && amixer -c "$audio_card" controls >/dev/null 2>&1; then
		(
			while true; do
				if amixer -c "$audio_card" cget numid=1 2>/dev/null | grep -q "values=on"; then
					target_state="HP"
					current_val="0"
				else
					target_state="SPK"
					current_val="1"
				fi
				if ! amixer -c "$audio_card" cget name='Playback Mux' 2>/dev/null | grep -q "values=$current_val"; then
					amixer -c "$audio_card" sset 'Playback Mux' "$target_state" >/dev/null 2>&1
				fi
				sleep 2
			done
		) &
		echo $! >/tmp/watch_jack.pid
	fi

	export HOME=/mnt/sdcard
	# Allium shells out to its bundled helpers (say/show/screenshot) which
	# live in .tmp_update/bin; make them resolvable on PATH.
	export PATH="/mnt/sdcard/.tmp_update/bin:/usr/bin:/bin:/sbin:/usr/sbin:${PATH:-}"

	for bl in /sys/class/backlight/*/brightness; do
		[ -w "$bl" ] && echo 5 >"$bl" 2>/dev/null || true
	done

	if [ -z "$UI_BIN" ] || ! [ -x "$UI_BIN" ]; then
		echo "No UI binary found" >/tmp/ui.log
		if [ -d /mnt/sdcard ]; then
			log_boot "ERROR: No UI binary found"
			cp -f /tmp/ui.log /mnt/sdcard/ui.log 2>/dev/null || true
			sync 2>/dev/null || true
		fi
		eend 0
		return 0
	fi

	if [ -d /mnt/sdcard ]; then
		log_boot "Executing ${UI_NAME} (${UI_BIN})"
		sync 2>/dev/null || true
	fi

	UI_DIR="$(dirname "$(dirname "$UI_BIN")")"
	if [ -d "${UI_DIR}/lib" ]; then
		export LD_LIBRARY_PATH="${UI_DIR}/lib:${LD_LIBRARY_PATH:-}"
	fi

	( "$UI_BIN" </dev/console >/tmp/ui.log 2>&1 ) &
	echo $! >/tmp/ui.pid

	# Detach the framebuffer console once the UI owns fb0 so kernel
	# messages and VT key echoes can no longer bleed through the UI.
	for vtcon in /sys/class/vtconsole/vtcon*/; do
		[ -r "${vtcon}/name" ] || continue
		if grep -q "frame buffer device" "${vtcon}/name" 2>/dev/null; then
			echo 0 >"${vtcon}/bind" 2>/dev/null || true
		fi
	done

	eend 0
}

stop() {
	ebegin "Stopping UI"

	UI_STOP_CMD=$(read_ui_env UI_STOP_CMD)
	UI_PROCESSES=$(read_ui_env UI_PROCESSES)

	if [ -f /tmp/watch_jack.pid ]; then
		kill "$(cat /tmp/watch_jack.pid)" 2>/dev/null || true
		rm -f /tmp/watch_jack.pid
	fi

	if [ -n "$UI_STOP_CMD" ]; then
		eval "$UI_STOP_CMD" >/dev/null 2>&1 || true
		sleep 1.0
	fi

	if [ -f /tmp/ui.pid ]; then
		loop_pid="$(cat /tmp/ui.pid)"
		pkill -P "$loop_pid" 2>/dev/null || true
		kill "$loop_pid" 2>/dev/null || true
		rm -f /tmp/ui.pid
	fi

	if [ -n "${UI_PROCESSES:-}" ]; then
		# shellcheck disable=SC2086
		killall $UI_PROCESSES 2>/dev/null || true
	fi

	eend 0
}
