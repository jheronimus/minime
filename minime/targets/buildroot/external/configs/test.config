# Minime Buildroot test fragment — opt-in diagnostic/stress packages.
# Merged into the defconfig only when TEST_PACKAGES=1 is passed to the build
# (see buildroot/scripts/build.sh defconfig).  Keeps release images lean;
# test images carry the ADR 0014 stability-test tooling:
#   - stress-ng: CPU/GPU/memory stress workloads (phase 1 changing loads).
#   - memtester: sustained userspace memory test (phase 2 soak).
BR2_PACKAGE_STRESS_NG=y
BR2_PACKAGE_MEMTESTER=y
