# shellcheck shell=sh disable=SC2034,SC2154,SC3043
pkgname=remote
pkgver=1.0.0
pkgrel=1
pkgdesc="Minime remote screenshot and input simulation tool"
url="https://github.com/jheronimus/minime"
arch="aarch64"
license="MIT"
options="!check"
makedepends="linux-headers"

build() {
	local src="${MINIME_ROOT:-/workspace}/src/remote"
	make -C "$src" clean
	make -C "$src" CC="${CC:-gcc}" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
	local src="${MINIME_ROOT:-/workspace}/src/remote"
	install -Dm755 "$src/remote" "$pkgdir/usr/bin/remote"
}
