# shellcheck shell=sh disable=SC2034,SC2154,SC3043
pkgname=minime-rotate
pkgver=1.0.0
pkgrel=1
pkgdesc="Set/query the DRM/KMS primary-plane rotation (display overlay helper)"
url="https://github.com/jheronimus/minime"
arch="aarch64"
license="MIT"
options="!check"
makedepends="linux-headers"

build() {
	local src="${MINIME_ROOT:-/workspace}/src/display"
	make -C "$src" clean
	make -C "$src" CC="${CC:-gcc}" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
	local src="${MINIME_ROOT:-/workspace}/src/display"
	install -Dm755 "$src/minime-rotate" "$pkgdir/usr/bin/minime-rotate"
}
