# Minime Alpine world (common) — package list shared by every board.
#
# Format: one package per line; lines starting with '#' are ignored.  The
# list is installed in the Alpine rootfs by `alpine/scripts/build.sh`
# after the local Minime package repo is staged at /local-repo.
#
# Local packages (built from minime/targets/alpine/aports/*):
#   - minui / allium      UI frontends (mutually exclusive, fetch-prebuilt)
#   - preloaded-roms      bundled ROMs
#   - fatresize           FAT32 resizer for first-boot expansion
#
# Notes:
#   - musl replaces glibc; the gcompat compatibility layer is intentionally
#     omitted.  Packages that hard-depend on glibc are not in this list.
#   - libmali / mali-kbase / vulkan-loader are intentionally absent: Alpine
#     uses Mesa Panfrost for GLES via DRM/GBM/KMS, and Vulkan is out of V1.
#   - geekbench is intentionally absent: the proprietary GLIBC prebuilt does
#     not run on musl and we are not building it from source.
#
# Kernel-related virtual packages let `apk` pull in the matching firmware
# fragments we already ship via CONFIG_EXTRA_FIRMWARE.

# ── Init + userspace base ────────────────────────────────────────────────
openrc
eudev
busybox
busybox-suid
busybox-extras
busybox-static
mksh
shadow
sudo
tzdata
ca-certificates
musl-locales
ncurses-terminfo
# ── Console + login ──────────────────────────────────────────────────────
gettext
# busybox provides login, getty (via openrc service), and autologin
# ── Filesystems / partitions ─────────────────────────────────────────────
parted
fatresize
e2fsprogs
dosfstools
f2fs-tools
util-linux
# ── Compression / archives ───────────────────────────────────────────────
zstd
xz
lz4
lz4-libs
# ── Networking (link/addr) ───────────────────────────────────────────────
iproute2
iputils
iproute2-minimal
# dropbear SSH server (started on demand, not enabled by default; see
# /etc/init.d/dropbear).  Provides an encrypted remote shell alongside telnet.
dropbear
# ── DNS / mDNS ───────────────────────────────────────────────────────────
# ── Wi-Fi + regulatory ───────────────────────────────────────────────────
# iwd (Internet Wireless Daemon) replaces wpa_supplicant: it does 802.11 + WPA
# natively with built-in DHCP (EnableNetworkConfiguration) and persists known
# networks in /var/lib/iwd (redirected to the FAT partition by the wifi
# service).  iwd depends on dbus (already in this list).
iwd
wireless-regdb
# wireless-regdb lives in /usr/share/wireless.  Realtek firmware fragments are
# installed by minime-overlay's post-install.
# ── Bluetooth (with audio sink) ──────────────────────────────────────────
dbus
bluez
bluez-deprecated
bluez-alsa
# ── Audio (ALSA) ─────────────────────────────────────────────────────────
alsa-lib
alsa-utils
alsa-plugins
# ── OpenGL ES / DRM/GBM / KMS / Vulkan (Mesa Panfrost & PanVK) ───────────
mesa
mesa-gl
mesa-dri-gallium
mesa-egl
mesa-gbm
mesa-gles
vulkan-loader
mesa-vulkan-panfrost
libdrm
# ── SDL2 (Alpine's sdl2 has KMSDRM/EGL/OpenGLES by default) ─────────────
sdl2
sdl2_image
sdl2_ttf
sdl2_mixer
# ── HTTP / media (UI runtime) ───────────────────────────────────────────
# curl: HTTPS client spawned by launcher updaters/scrapers.
# ffmpeg: FFmpeg shared libraries (libavcodec/libavformat/...) linked by
#         launcher UIs (e.g. muOS) and a usable ffmpeg/ffprobe binary.
curl
ffmpeg
# ── Minime firmware pieces (libpng/zlib are SDL_image deps) ─────────────
libpng
zlib
# ── Local Minime packages (built by alpine/aports/*) ─────────────────────
# minui / allium   UI frontends (mutually exclusive, fetch-prebuilt)
# fatresize        FAT32 expansion
# libretro-headers  libretro.h
