#!/sbin/openrc-run
# shellcheck disable=SC2034
# wifi: wpa_supplicant + udhcpc. Keep behavior aligned with
# /usr/share/minime/scripts/wifi.

description="Minime Wi-Fi (wpa_supplicant + udhcpc)"

depend() {
	need localmount
	need modules
	after fb-unblank
}

start() {
	ebegin "Starting Wi-Fi"
	/usr/share/minime/scripts/wifi.sh start
	eend $?
}

stop() {
	ebegin "Stopping Wi-Fi"
	/usr/share/minime/scripts/wifi.sh stop
	eend $?
}
