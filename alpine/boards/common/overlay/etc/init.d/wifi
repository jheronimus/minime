#!/sbin/openrc-run
# shellcheck disable=SC2034
# wifi: iwd (Internet Wireless Daemon).  iwd does 802.11 + WPA natively and,
# with EnableNetworkConfiguration=true (see /etc/iwd/main.conf), provides its
# own DHCP client.  Known networks persist as .psk profiles in the writable
# state directory on the FAT partition.

description="Minime Wi-Fi (iwd)"

# --- Configuration ---
wifi_interface="wlan0"
iwd_state_dir="/mnt/sdcard/.minime/config/iwd"
iwd_seed_dir="/mnt/sdcard/.minime/config/iwd/seed"
wifi_config_file="/mnt/sdcard/.minime/config/wifi.cfg"
wpa_supplicant_conf="/mnt/sdcard/.minime/config/wifi/wpa_supplicant.conf"
dbus_pidfile="/run/dbus/pid"
iwd_pidfile="/run/iwd.pid"
diagnostic_logfile="/tmp/wifi.diagnostics"

# --- Timeouts ---
station_connect_wait_seconds=40
wifi_driver_wait_seconds=5

# --- Helper functions ---

log_boot() {
	/usr/share/minime/scripts/log-boot.sh WIFI "$@" 2>/dev/null || true
}

start_dbus() {
	[ -d /run/dbus ] || mkdir -p /run/dbus
	if ! [ -f /run/dbus/dbus.pid ] || ! kill -0 "$(cat /run/dbus/dbus.pid 2>/dev/null)" 2>/dev/null; then
		rm -f /run/dbus/dbus.pid 2>/dev/null || true
		dbus-daemon --system --fork 2>/dev/null || true
	fi
}

profile_file_for() {
	# iwd profile filename encoding (iwd.network(5)):
	# The SSID is used verbatim only if it is alphanumeric + space + '_' + '-'.
	# Any other character (e.g. '&' in 'Greeks & Geeks') requires the filename
	# to be '=' followed by the lowercase hex representation of the SSID.
	ssid="$1"
	case "${ssid}" in
	*[!A-Za-z0-9_\ -]*)
		printf '=%s\n' "$(printf '%s' "${ssid}" | od -An -tx1 | tr -d ' \n')"
		;;
	*)
		printf '%s\n' "${ssid}"
		;;
	esac
}

write_profile() {
	ssid="$1"
	psk="$2"
	[ -n "$ssid" ] || return 0
	name="$(profile_file_for "$ssid")"
	profile="${iwd_state_dir}/${name}.psk"
	{
		printf '[Security]\n'
		if [ -n "$psk" ]; then
			printf 'Passphrase=%s\n' "$psk"
		fi
		printf '[Settings]\nAutoConnect=true\n'
	} >"${profile}" 2>/dev/null
	chmod 600 "${profile}" 2>/dev/null || true
}

migrate_legacy_configs() {
	mkdir -p "${iwd_state_dir}"

	# Check root wifi.cfg or .minime/config/wifi.cfg
	for cfg in "/mnt/sdcard/wifi.cfg" "${wifi_config_file}"; do
		if [ -f "${cfg}" ]; then
			ssid=""
			psk=""
			while IFS='=' read -r key val || [ -n "$key" ]; do
				[ -n "$key" ] || continue
				key=$(printf '%s' "$key" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
				val=$(printf '%s' "$val" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^"//;s/"$//')
				case "$key" in
				\#*) continue ;;
				SSID)
					if [ -n "$ssid" ]; then
						write_profile "$ssid" "$psk"
						psk=""
					fi
					ssid="$val"
					;;
				Passphrase) psk="$val" ;;
				esac
			done <"${cfg}"
			if [ -n "$ssid" ]; then
				write_profile "$ssid" "$psk"
			fi
		fi
	done

	# One-time migration from existing wpa_supplicant.conf
	if [ -f "${wpa_supplicant_conf}" ]; then
		cur_ssid="$(grep -E '^\s*ssid=' "${wpa_supplicant_conf}" 2>/dev/null | head -n 1 | cut -d= -f2- | tr -d '"\r' || true)"
		cur_psk="$(grep -E '^\s*psk=' "${wpa_supplicant_conf}" 2>/dev/null | head -n 1 | cut -d= -f2- | tr -d '"\r' || true)"
		if [ -n "$cur_ssid" ]; then
			write_profile "$cur_ssid" "$cur_psk"
		fi
	fi
}

seed_iwd_profiles() {
	[ -d "${iwd_seed_dir}" ] || return 0
	mkdir -p "${iwd_state_dir}"
	for profile in "${iwd_seed_dir}"/*.psk; do
		[ -f "${profile}" ] || continue
		cp -f "${profile}" "${iwd_state_dir}/" 2>/dev/null || true
	done
}

check_wifi_hardware() {
	i=0
	if command -v rfkill >/dev/null 2>&1; then
		rfkill unblock wifi >/dev/null 2>&1 || true
	fi
	while [ "${i}" -lt "${wifi_driver_wait_seconds}" ]; do
		if ip link show "${wifi_interface}" >/dev/null 2>&1; then
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done
	return 1
}

wait_for_connected() {
	i=0
	while [ "${i}" -lt "${station_connect_wait_seconds}" ]; do
		if ! kill -0 "$(cat "${iwd_pidfile}" 2>/dev/null)" 2>/dev/null; then
			return 1
		fi
		if [ "$(cat "/sys/class/net/${wifi_interface}/carrier" 2>/dev/null)" = "1" ] && \
		   ip -4 addr show "${wifi_interface}" 2>/dev/null | grep -q "inet "; then
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done
	return 1
}

log_failure_diagnostics() {
	reason="$1"
	{
		printf '%s\n' "reason=${reason}"
		printf '%s ' "/sys/class/net/${wifi_interface}:"
		if [ -e "/sys/class/net/${wifi_interface}" ]; then
			printf '%s\n' "present"
			ip link show "${wifi_interface}" 2>&1 || true
		else
			printf '%s\n' "missing"
		fi
		printf '%s\n' "/sys/bus/sdio/devices:"
		ls -la /sys/bus/sdio/devices 2>&1 || true
		printf '%s\n' "iwctl station ${wifi_interface} show:"
		if command -v iwctl >/dev/null 2>&1; then
			iwctl station "${wifi_interface}" show 2>&1 || true
		else
			printf '%s\n' "iwctl missing"
		fi
		printf '%s\n' "iwd profiles:"
		ls -la "${iwd_state_dir}" 2>&1 || true
	} >>"${diagnostic_logfile}"
	if [ -d /mnt/sdcard ]; then
		cp -f "${diagnostic_logfile}" /mnt/sdcard/wifi.diagnostics 2>/dev/null || true
		log_boot "startup failed: ${reason}; diagnostics in /mnt/sdcard/wifi.diagnostics"
	fi
	logger -t wifi "startup failed: ${reason}; diagnostics in ${diagnostic_logfile}" 2>/dev/null || true
	echo "wifi: startup failed: ${reason}" >&2
}

# --- OpenRC service ---

depend() {
	need localmount
	need modules
	after fb-unblank
}

start() {
	ebegin "Starting Wi-Fi (iwd)"

	if ! check_wifi_hardware; then
		log_failure_diagnostics "missing-${wifi_interface}"
		eend 1 "no ${wifi_interface} interface found"
		return 1
	fi

	start_dbus

	mkdir -p "${iwd_state_dir}"
	migrate_legacy_configs
	seed_iwd_profiles

	# Start iwd with STATE_DIRECTORY pointing to the SD card
	iwd_bin="$(command -v iwd 2>/dev/null || echo /usr/libexec/iwd)"
	if ! env STATE_DIRECTORY="${iwd_state_dir}" start-stop-daemon -S -q -b -m \
		-p "${iwd_pidfile}" \
		-x "${iwd_bin}" -- 2>>"${diagnostic_logfile}"; then
		# Already running is fine
		if [ -f "${iwd_pidfile}" ] && kill -0 "$(cat "${iwd_pidfile}" 2>/dev/null)" 2>/dev/null; then
			log_boot "iwd already running"
		else
			log_failure_diagnostics "iwd-failed-to-start"
			eend 1 "iwd failed to start"
			return 1
		fi
	fi

	sleep 2

	# Trigger scan and explicit connect in case auto-connect is sluggish on initial boot
	if command -v iwctl >/dev/null 2>&1; then
		iwctl station "${wifi_interface}" scan >/dev/null 2>&1 || true
		sleep 2
		if [ -n "${cur_ssid:-}" ]; then
			iwctl station "${wifi_interface}" connect "${cur_ssid}" >/dev/null 2>&1 || true
		fi
	fi

	if ! wait_for_connected; then
		log_failure_diagnostics "station-connect-timeout"
		eend 1 "not connected"
		return 1
	fi

	logger -t wifi "connection established" 2>/dev/null || true
	log_boot "Connection established with IP"

	if command -v ntpd >/dev/null 2>&1; then
		killall ntpd 2>/dev/null || true
		ntpd -p pool.ntp.org
	fi

	eend 0
}

stop() {
	ebegin "Stopping Wi-Fi"
	if [ -f "${iwd_pidfile}" ]; then
		kill "$(cat "${iwd_pidfile}")" >/dev/null 2>&1 || true
		rm -f "${iwd_pidfile}"
	fi
	ip link set "${wifi_interface}" down >/dev/null 2>&1 || true
	eend 0
}

reload() {
	ebegin "Reloading Wi-Fi"
	migrate_legacy_configs
	seed_iwd_profiles
	eend 0
}
