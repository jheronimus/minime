#!/sbin/openrc-run
# shellcheck disable=SC2034
# thermal-watchdog: Userspace thermal watchdog for RK3566.
# Shared location — Alpine and Buildroot both copy from here.

description="RK3566 thermal watchdog"

PIDFILE="/run/thermal-watchdog.pid"

depend() {
	need modules localmount
	before ui
}

start() {
	ebegin "Starting thermal watchdog"
	/usr/share/minime/scripts/thermal-watchdog test || { eend 1 "self-test failed"; return 1; }
	start-stop-daemon -S -q -b -m \
		-p "$PIDFILE" -x /usr/share/minime/scripts/thermal-watchdog -- run
	eend $?
}

stop() {
	ebegin "Stopping thermal watchdog"
	start-stop-daemon -K -q -p "$PIDFILE"
	eend $?
}
