[submodule "packages/ui/allium"]
	path = packages/ui/allium
	url = https://github.com/jheronimus/Allium
	branch = main
[submodule "packages/ui/minui"]
	path = packages/ui/minui
	url = https://github.com/jheronimus/MinUI
	branch = main
# muOS frontend (upstream). Pinned to main; the Minime port delta (patches +
# overlay) lives in packages/ui/muos/.
[submodule "packages/ui/muos/frontend"]
	path = packages/ui/muos/frontend
	url = https://github.com/MustardOS/frontend.git
	branch = main
[submodule "src/yabause"]
	path = src/yabause
	url = https://github.com/jheronimus/yabause
	branch = main
[submodule "src/drastic"]
	path = src/drastic
	url = https://github.com/jheronimus/drastic
	branch = main
# muOS runtime payload (upstream internal). update=none: recursive checkouts
# skip it; the muos build jobs sparse-clone only share/ + script/ via
# packages/ui/muos-checkout-internal.sh. Browse it with the helper or
# `git submodule update --init packages/ui/muos/internal`.
[submodule "packages/ui/muos/internal"]
	path = packages/ui/muos/internal
	url = https://github.com/MustardOS/internal.git
	branch = main
	shallow = true
	update = none
[submodule "roms/tinyset"]
	path = roms/tinyset
	url = ssh://git@htpc.local:2222/ilembitov/tinyset.git
	branch = main
	update = none
