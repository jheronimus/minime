# shellcheck shell=sh disable=SC2034,SC2154,SC3043
pkgname=bt-mirror
pkgver=1.0.0
pkgrel=1
pkgdesc="Minime Bluetooth audio mirror helper"
url="https://github.com/jheronimus/minime"
arch="aarch64"
license="MIT"
options="!check"

build() {
	local src="${MINIME_ROOT:-/workspace}/src/bt-mirror"
	make -C "$src" clean
	make -C "$src" CC="${CC:-gcc}" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
	install -Dm755 "${MINIME_ROOT:-/workspace}/src/bt-mirror/bt-mirror" "$pkgdir/usr/bin/bt-mirror"
}
