# Architecture
BR2_aarch64=y

# Toolchain (external AArch64 glibc)
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_ARM_AARCH64=y

# Host toolchains
BR2_PACKAGE_HOST_GO_BIN=y
BR2_PACKAGE_HOST_RUST_BIN=y

# Download / cache
BR2_DL_DIR="~/.buildroot-dl"
# BR2_DOWNLOAD_FORCE_CHECK_HASHES is not set
# Don't preserve archiving ownership when extracting sources; running as root
# in CI containers, GNU tar otherwise fails to chown files owned by the
# original packager's uid/gid on runner overlay filesystems.
BR2_TAR_OPTIONS="--no-same-owner"
BR2_CCACHE=y
BR2_CCACHE_DIR="~/.buildroot-ccache"
BR2_CCACHE_INITIAL_SETUP="--max-size=30G"

# Optimisation
BR2_OPTIMIZE_3=y
BR2_ENABLE_LTO=y

# Rootfs base
BR2_TARGET_GENERIC_HOSTNAME="minime"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# Root password empty: Minime has no auth model (telnet autologin + dropbear
# blank-password root, matching telnet).  See docs/adr/0011-networking.md.
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_ROOTFS_OVERLAY="$(MINIME_ROOT)/packages/components/boards/common/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_MINIME_PATH)/scripts/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_MINIME_PATH)/scripts/system-image.sh"
BR2_TARGET_ROOTFS_TAR=y

# Init system (OpenRC — same as Alpine)
BR2_INIT_OPENRC=y

# Busybox
BR2_PACKAGE_BUSYBOX_STATIC=y
# Applets required by the shared overlay services: passwordless telnetd
# (init.d/telnetd) and the tcpsvd/ftpd FTP pair (init.d/ftpd). The stock
# BusyBox config disables all of them.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(MINIME_ROOT)/packages/components/boards/common/busybox.config"

# Kernel base
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.1.5"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(MINIME_ROOT)/packages/components/boards/common/tiny-base.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y

# Bluetooth / Wi-Fi base
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO=y
BR2_PACKAGE_BLUEZ_ALSA=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_IWD=y
BR2_PACKAGE_READLINE=y

# Remote access
BR2_PACKAGE_DROPBEAR=y

# Audio
BR2_PACKAGE_ALSA_UTILS=y
# BR2_PACKAGE_ALSA_UTILS_ALSACTL is not set
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_LIBSAMPLERATE=y

# Filesystem / partitioning
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_FATRESIZE=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_ZSTD=y
BR2_PACKAGE_LZ4=y
# mkfs.ext4/e2fsck for the dedicated Bluetooth state partition
BR2_PACKAGE_E2FSPROGS=y

# SDL / graphics (libmali provides EGL, GLES, GBM)
BR2_PACKAGE_LIBMALI=y
BR2_PACKAGE_MALI_KBASE=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_SDL2_IMAGE_PNG=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_SDL2_MIXER=y
BR2_PACKAGE_LIBPNG=y

# HTTP / media (UI runtime): curl + ffmpeg are linked/spawned by launcher UIs
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_SWSCALE=y

# System libraries
BR2_PACKAGE_LIBXML2=y
BR2_PACKAGE_LIBFFI=y
BR2_PACKAGE_LIBEDIT=y

# Network / mDNS
BR2_PACKAGE_MDNSD=y
BR2_PACKAGE_OPENRESOLV=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y

# Remote diagnostics & input simulation
BR2_PACKAGE_REMOTE=y
BR2_PACKAGE_MINIME_ROTATE=y
BR2_PACKAGE_BENCHMARK=y
BR2_PACKAGE_BOOTSPLASH=y
BR2_PACKAGE_BT_MIRROR=y
