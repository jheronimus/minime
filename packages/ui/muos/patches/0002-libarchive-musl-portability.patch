From: Minime <maintainers@minime-os.local>
Subject: [PATCH] libarchive: undefine HAVE_ARC4RANDOM_BUF for musl portability

Minime-specific port patch (see docs/adr/0008-ui.md).
---
diff --git a/common/libarchive/config.h b/common/libarchive/config.h
index 12562bc6..9f3c9bfb 100755
--- a/common/libarchive/config.h
+++ b/common/libarchive/config.h
@@ -296,7 +296,7 @@
 /* #undef HAVE_ACL_TAG_T */
 
 /* Define to 1 if you have the `arc4random_buf' function. */
-#define HAVE_ARC4RANDOM_BUF 1
+/* #undef HAVE_ARC4RANDOM_BUF */
 
 /* Define to 1 if you have the <attr/xattr.h> header file. */
 /* #undef HAVE_ATTR_XATTR_H */
