From: Minime <maintainers@minime-os.local>
Subject: [PATCH] options: make OPT_PATH and MAIN_ROM_DIR overridable for Minime

Minime-specific port patch (see docs/adr/0028-muos-frontend-port.md).
---
diff --git a/common/options.h b/common/options.h
index 9aaa9e34..ebaab1a9 100755
--- a/common/options.h
+++ b/common/options.h
@@ -65,7 +65,9 @@
 
 #define LOCAL_TIME "/etc/localtime"
 
-#define OPT_PATH "/opt/muos/"
+#ifndef OPT_PATH
+#define OPT_PATH "/mnt/sdcard/.muos/"
+#endif
 #define RUN_PATH "/run/muos/"
 
 #define CONTROL_MODERN OPT_PATH "share/info/gamecontrollerdb/modern.txt"
@@ -84,7 +86,9 @@
 #define OSK_DONE "OK"
 #define OSK_MAX  192
 
-#define MAIN_ROM_DIR "ROMS"
+#ifndef MAIN_ROM_DIR
+#define MAIN_ROM_DIR "Roms"
+#endif
 
 #define CHIME_DONE "/tmp/chime_done"
 #define SAFE_QUIT  RUN_PATH "safe_quit"
